# Copy to .env and fill in from Supabase dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RentAnything support WhatsApp number shown to owners whose listing is hidden
# and in Account → Help & support, e.g. 077 123 4567. Leave empty to hide.
EXPO_PUBLIC_SUPPORT_WHATSAPP=
